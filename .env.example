# SportMonks Football API v3 token.
# Dashboard: https://my.sportmonks.com/
# Sent only as a request parameter at runtime. Never commit a real token.
# The free plan does not include La Liga (league id 564). Use a plan that
# covers Spanish Primera División, including the historical seasons you fetch.
SPORTMONKS_API_TOKEN=

# Optional. Defaults to ./data under the current working directory.
# LALIGA_DATA_DIR=data
